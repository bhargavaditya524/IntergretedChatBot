@{
    ViewData["Title"] = "AI Chat";
    Layout = null; // standalone page; remove this line if you want _Layout.cshtml around it
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg: #eef1f4;
            --panel: #ffffff;
            --ink: #1b2430;
            --muted: #6b7686;
            --line: #d9dfe6;
            --user: #1f4e79;
            --user-ink: #ffffff;
            --ai: #e8edf2;
            --accent: #1f4e79;
            --error: #b3261e;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #12171d;
                --panel: #1a2129;
                --ink: #e6ebf0;
                --muted: #8a96a5;
                --line: #2b3541;
                --user: #3b7bb8;
                --user-ink: #ffffff;
                --ai: #232d38;
                --accent: #3b7bb8;
                --error: #f2b8b5;
            }
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
            background: var(--bg);
            color: var(--ink);
            font-family: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
            display: flex;
            justify-content: center;
        }
        .chat {
            width: 100%;
            max-width: 760px;
            height: 100%;
            display: flex;
            flex-direction: column;
            background: var(--panel);
            border-left: 1px solid var(--line);
            border-right: 1px solid var(--line);
        }
        header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        header h1 { font-size: 1.05rem; margin: 0; font-weight: 600; }
        header button {
            background: none; border: 1px solid var(--line); color: var(--muted);
            padding: 6px 12px; border-radius: 6px; cursor: pointer; font: inherit; font-size: .85rem;
        }
        header button:hover { color: var(--ink); }
        .documents {
            padding: 12px 20px;
            border-bottom: 1px solid var(--line);
            color: var(--muted);
            font-size: .85rem;
        }
        .document-upload { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
        .document-upload input { min-width: 0; flex: 1; color: var(--ink); }
        .document-upload button, .document-actions button {
            padding: 5px 9px;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: var(--panel);
            color: var(--ink);
            font: inherit;
            cursor: pointer;
        }
        .document-upload button:disabled, .document-actions button:disabled { opacity: .5; cursor: wait; }
        #documentStatus { margin: 8px 0 0; }
        #documentStatus.error, .document-error { color: var(--error); }
        #documentList { list-style: none; margin: 8px 0 0; padding: 0; }
        #documentList li { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; padding: 4px 0; }
        .document-name { color: var(--ink); overflow-wrap: anywhere; }
        .document-actions { display: inline-flex; gap: 6px; margin-left: auto; }
        #messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .empty { margin: auto; color: var(--muted); text-align: center; max-width: 320px; line-height: 1.5; }
        .msg {
            max-width: 82%;
            padding: 10px 14px;
            border-radius: 14px;
            line-height: 1.5;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .msg.user { align-self: flex-end; background: var(--user); color: var(--user-ink); border-bottom-right-radius: 4px; }
        .msg.ai { align-self: flex-start; background: var(--ai); border-bottom-left-radius: 4px; }
        .msg.error { align-self: flex-start; background: transparent; color: var(--error); border: 1px solid var(--error); }
        .typing { display: inline-flex; gap: 4px; padding: 4px 0; }
        .typing span {
            width: 7px; height: 7px; border-radius: 50%; background: var(--muted);
            animation: blink 1.2s infinite ease-in-out;
        }
        .typing span:nth-child(2) { animation-delay: .2s; }
        .typing span:nth-child(3) { animation-delay: .4s; }
        @@keyframes blink { 0%, 80%, 100% { opacity: .25; } 40% { opacity: 1; } }
        @@media (prefers-reduced-motion: reduce) { .typing span { animation: none; opacity: .6; } }
        form {
            display: flex;
            gap: 10px;
            padding: 14px 20px;
            border-top: 1px solid var(--line);
        }
        textarea {
            flex: 1;
            resize: none;
            max-height: 140px;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--panel);
            color: var(--ink);
            font: inherit;
            line-height: 1.4;
        }
        textarea:focus, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
        form button {
            padding: 0 20px;
            border: none;
            border-radius: 10px;
            background: var(--accent);
            color: #fff;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }
        form button:disabled { opacity: .5; cursor: not-allowed; }
    </style>
</head>
<body>
    <main class="chat">
        <header>
            <h1>AI Chat</h1>
            <button type="button" id="clearBtn">Clear chat</button>
        </header>

        <section class="documents" aria-label="Shared documents">
            <form class="document-upload" id="documentForm">
                <label for="documentFile">Knowledge base</label>
                <input id="documentFile" type="file" accept=".pdf,.docx,.txt" aria-label="PDF, DOCX, or TXT document" />
                <button type="submit" id="uploadBtn">Add document</button>
            </form>
            <p id="documentStatus" role="status">PDF, DOCX, or TXT; maximum 10 MB per file.</p>
            <ul id="documentList" aria-label="Uploaded documents"></ul>
        </section>

        <div id="messages" aria-live="polite">
            <div class="empty" id="empty">Ask a question to get started. Press Enter to send, Shift+Enter for a new line.</div>
        </div>

        <form id="chatForm">
            <textarea id="input" rows="1" placeholder="Type your message" aria-label="Message" autofocus></textarea>
            <button type="submit" id="sendBtn">Send</button>
        </form>
    </main>

    <script>
        const API_URL = "/api/chat";   // same origin as the MVC app

        const messagesEl = document.getElementById("messages");
        const emptyEl = document.getElementById("empty");
        const form = document.getElementById("chatForm");
        const input = document.getElementById("input");
        const sendBtn = document.getElementById("sendBtn");
        const clearBtn = document.getElementById("clearBtn");
        const documentForm = document.getElementById("documentForm");
        const documentFile = document.getElementById("documentFile");
        const uploadBtn = document.getElementById("uploadBtn");
        const documentStatus = document.getElementById("documentStatus");
        const documentList = document.getElementById("documentList");

        async function responseError(response) {
            try {
                const data = await response.json();
                return data.error || "Request failed with status " + response.status;
            } catch {
                return "Request failed with status " + response.status;
            }
        }

        async function refreshDocuments() {
            try {
                const response = await fetch("/api/documents");
                if (!response.ok) throw new Error(await responseError(response));
                const documents = await response.json();
                documentList.replaceChildren();

                for (const documentInfo of documents) {
                    const item = document.createElement("li");
                    const name = document.createElement("span");
                    name.className = "document-name";
                    name.textContent = documentInfo.fileName;
                    const state = document.createElement("span");
                    state.className = documentInfo.status === "Failed" ? "document-error" : "";
                    state.textContent = documentInfo.error
                        ? documentInfo.status + ": " + documentInfo.error
                        : documentInfo.status;
                    item.append(name, state);

                    const actions = document.createElement("span");
                    actions.className = "document-actions";
                    if (documentInfo.status !== "Processing") {
                        const retry = document.createElement("button");
                        retry.type = "button";
                        retry.textContent = documentInfo.status === "Failed" ? "Retry" : "Reindex";
                        retry.addEventListener("click", () => reindexDocument(documentInfo.id, retry));
                        actions.appendChild(retry);
                    }

                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.textContent = "Remove";
                    remove.addEventListener("click", () => deleteDocument(documentInfo.id, remove));
                    actions.appendChild(remove);
                    item.appendChild(actions);
                    documentList.appendChild(item);
                }
            } catch (error) {
                documentStatus.className = "error";
                documentStatus.textContent = "Could not load documents: " + error.message;
            }
        }

        async function reindexDocument(id, button) {
            button.disabled = true;
            try {
                const response = await fetch("/api/documents/" + encodeURIComponent(id) + "/reindex", { method: "POST" });
                if (!response.ok) throw new Error(await responseError(response));
                documentStatus.className = "";
                documentStatus.textContent = "Document indexed.";
            } catch (error) {
                documentStatus.className = "error";
                documentStatus.textContent = error.message;
            } finally {
                await refreshDocuments();
            }
        }

        async function deleteDocument(id, button) {
            button.disabled = true;
            try {
                const response = await fetch("/api/documents/" + encodeURIComponent(id), { method: "DELETE" });
                if (!response.ok) throw new Error(await responseError(response));
                documentStatus.className = "";
                documentStatus.textContent = "Document removed.";
            } catch (error) {
                documentStatus.className = "error";
                documentStatus.textContent = error.message;
            } finally {
                await refreshDocuments();
            }
        }

        function addMessage(text, type) {
            if (emptyEl) emptyEl.remove();
            const div = document.createElement("div");
            div.className = "msg " + type;
            div.textContent = text;           // textContent: safe against HTML injection
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
            return div;
        }

        function addTyping() {
            const div = addMessage("", "ai");
            div.innerHTML = '<span class="typing"><span></span><span></span><span></span></span>';
            return div;
        }

        async function send() {
            const text = input.value.trim();
            if (!text) return;

            addMessage(text, "user");
            input.value = "";
            input.style.height = "auto";
            sendBtn.disabled = true;
            const typing = addTyping();

            try {
                const res = await fetch(API_URL, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ message: text })
                });
                if (!res.ok) throw new Error(await responseError(res));
                const data = await res.json();
                typing.className = "msg ai";
                typing.textContent = data.ai ?? "(empty response)";
                if (data.sources?.length) {
                    const sourceText = data.sources
                        .map(source => source.reference + " " + source.fileName +
                            (source.pageNumber ? ", page " + source.pageNumber : ""))
                        .join("; ");
                    const sourceLine = document.createElement("small");
                    sourceLine.textContent = "Sources: " + sourceText;
                    typing.appendChild(document.createElement("br"));
                    typing.appendChild(sourceLine);
                }
            } catch (err) {
                typing.className = "msg error";
                typing.textContent = "Could not get a reply: " + err.message + ". Check the server and try again.";
            } finally {
                sendBtn.disabled = false;
                input.focus();
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }
        }

        form.addEventListener("submit", (e) => { e.preventDefault(); send(); });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); }
        });

        input.addEventListener("input", () => {
            input.style.height = "auto";
            input.style.height = Math.min(input.scrollHeight, 140) + "px";
        });

        clearBtn.addEventListener("click", () => location.reload());

        documentForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            const file = documentFile.files[0];
            if (!file) {
                documentStatus.className = "error";
                documentStatus.textContent = "Choose a PDF, DOCX, or TXT file first.";
                return;
            }

            uploadBtn.disabled = true;
            documentStatus.className = "";
            documentStatus.textContent = "Uploading and indexing " + file.name + "...";
            try {
                const formData = new FormData();
                formData.append("file", file);
                const response = await fetch("/api/documents", { method: "POST", body: formData });
                if (!response.ok) throw new Error(await responseError(response));
                documentStatus.textContent = "Document indexed.";
                documentFile.value = "";
            } catch (error) {
                documentStatus.className = "error";
                documentStatus.textContent = error.message;
            } finally {
                uploadBtn.disabled = false;
                await refreshDocuments();
            }
        });

        refreshDocuments();
    </script>
</body>
</html>
